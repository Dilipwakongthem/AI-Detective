    "mystery",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@parcel/transformer-react-refresh-wrap": "^2.12.0",
    "localtunnel": "^2.0.2",
    "parcel": "^2.12.0",
    "process": "^0.11.10"
  }
}
