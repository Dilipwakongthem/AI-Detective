{
  "name": "crime-scene-detective-game",
  "version": "1.0.0",
  "description": "AI Detective Mystery Game - JSX/React Web Version",
  "scripts": {
    "start": "parcel public/index.html --no-cache",
    "build": "parcel build public/index.html --dist-dir dist"
  },
  "targets": {
    "default": {
      "engines": {
        "browsers": "> 0.5%, last 2 versions, not dead"
